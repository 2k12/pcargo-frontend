# URL base de la API. Por defecto '/api' (el dev server de Vite hace proxy a http://localhost:3000).
# VITE_API_URL=/api

# URL pública del sitio, sin barra final. Se usa para que la vista previa al compartir el enlace
# (WhatsApp, Facebook, X) muestre la imagen: esas apps exigen URLs absolutas en og:image y og:url.
# VITE_SITE_URL=https://pcargo.ec
